{
  "name": "mcp-trunc-proxy",
  "version": "0.1.0",
  "description": "Generic MCP stdio proxy that offloads large tools/call results to an artifact store (memory by default) and returns small previews + retrieval tool.",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "Marco Jardim",
  "bin": {
    "mcp-trunc-proxy": "src/cli.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "scripts": {
    "start": "node src/cli.mjs --help",
    "lint": "eslint src/ examples/",
    "test": "node --test tests/unit/*.test.mjs tests/functional/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:functional": "node --test tests/functional/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "test:all": "node --test tests/**/*.test.mjs",
    "test:smoke": "node ./examples/fake-mcp-server.mjs",
    "benchmark": "node benchmarks/run-all.mjs",
    "benchmark:tokens": "node benchmarks/token-reduction.mjs",
    "benchmark:perf": "node benchmarks/performance.mjs"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "proxy",
    "tokens",
    "redis",
    "artifact"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marco-jardim/mcp-trunc-proxy"
  }
}
